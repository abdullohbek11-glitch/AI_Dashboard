{
  "about": "DRAFT v1 of the golden set: 30 questions for you to correct (add, remove, reword). Each has what a right answer must contain and an ORACLE: a query run on the same database at test time, so the expected number is never stale. Run: scripts/run_golden.py (needs a real AI key; see DEFERRED.md).",
  "placeholders": "$today, $week_start, $month_start, $last_month_start, $quarter_start, $year_start, $days_ago_7 are local midnights of the asking user's time zone, written as UTC datetimes.",
  "questions": [
    {"id": "F00", "smoke": true, "user": "boshliq", "role": "manager", "category": "pipeline", "requires": ["sale"],
     "question": "Build a dashboard of sales this month by day and the top 10 products",
     "expect": {"source": ["sale.report"], "measures_any": ["price_subtotal"], "must_filter": [["state", "=", "sale"]], "widgets": [1, 4]},
     "oracle": {"model": "sale.report", "domain": [["state", "=", "sale"], ["date", ">=", "$month_start"]], "measure": "price_subtotal:sum", "compare": {"widget": 0, "how": "sum_rows"}}},

    {"id": "S01", "user": "boshliq", "role": "manager", "category": "sales", "requires": ["sale"],
     "question": "Show this month's sales by day",
     "expect": {"source": ["sale.report"], "measures_any": ["price_subtotal", "price_total"], "must_filter": [["state", "=", "sale"]], "widgets": [1, 3]},
     "oracle": {"model": "sale.report", "domain": [["state", "=", "sale"], ["date", ">=", "$month_start"]], "measure": "price_subtotal:sum", "compare": {"widget": 0, "how": "sum_rows"}}},
    {"id": "S02", "user": "boshliq", "role": "manager", "category": "sales", "requires": ["sale"],
     "question": "Which 10 products sell the most this month?",
     "expect": {"source": ["sale.report"], "measures_any": ["product_uom_qty", "price_subtotal"], "must_filter": [["state", "=", "sale"]], "widgets": [1, 3]},
     "oracle": {"model": "sale.report", "domain": [["state", "=", "sale"], ["date", ">=", "$month_start"]], "groupby": "product_id", "measure": "product_uom_qty:sum", "order": "desc", "top": 10, "compare": {"widget": 0, "how": "top_names"}}},
    {"id": "S03", "user": "boshliq", "role": "manager", "category": "sales", "requires": ["sale"],
     "question": "Top 5 customers by revenue this year",
     "expect": {"source": ["sale.report"], "measures_any": ["price_subtotal", "price_total"], "must_filter": [["state", "=", "sale"]], "widgets": [1, 3]},
     "oracle": {"model": "sale.report", "domain": [["state", "=", "sale"], ["date", ">=", "$year_start"]], "groupby": "partner_id", "measure": "price_subtotal:sum", "order": "desc", "top": 5, "compare": {"widget": 0, "how": "top_names"}}},
    {"id": "S04", "user": "boshliq", "role": "manager", "category": "sales", "requires": ["sale"],
     "question": "Revenue by salesperson this month",
     "expect": {"source": ["sale.report"], "measures_any": ["price_subtotal", "price_total"], "must_filter": [["state", "=", "sale"]], "widgets": [1, 3]},
     "oracle": {"model": "sale.report", "domain": [["state", "=", "sale"], ["date", ">=", "$month_start"]], "measure": "price_subtotal:sum", "compare": {"widget": 0, "how": "sum_rows"}}},
    {"id": "S05", "user": "boshliq", "role": "manager", "category": "sales", "requires": ["sale"],
     "question": "How many orders did we confirm this month?",
     "expect": {"source": ["sale.report", "sale.order"], "must_filter": [["state", "=", "sale"]], "widgets": [1, 2]},
     "oracle": {"model": "sale.order", "domain": [["state", "=", "sale"], ["date_order", ">=", "$month_start"]], "measure": "__count", "compare": {"widget": 0, "how": "sum_rows"}}},
    {"id": "S06", "user": "boshliq", "role": "manager", "category": "sales", "requires": ["sale"],
     "question": "Monthly revenue this year",
     "expect": {"source": ["sale.report"], "measures_any": ["price_subtotal", "price_total"], "must_filter": [["state", "=", "sale"]], "widgets": [1, 3]},
     "oracle": {"model": "sale.report", "domain": [["state", "=", "sale"], ["date", ">=", "$year_start"]], "measure": "price_subtotal:sum", "compare": {"widget": 0, "how": "sum_rows"}}},
    {"id": "S07", "user": "boshliq", "role": "manager", "category": "sales", "requires": ["sale"],
