     "oracle": {"model": "sale.report", "domain": [["state", "=", "sale"], ["date", ">=", "$quarter_start"]], "measure": "price_subtotal:sum", "compare": {"widget": 0, "how": "sum_rows"}}},
    {"id": "S12", "user": "boshliq", "role": "manager", "category": "sales", "requires": ["sale"],
     "question": "Revenue by sales team this year",
     "expect": {"source": ["sale.report"], "measures_any": ["price_subtotal", "price_total"], "must_filter": [["state", "=", "sale"]], "widgets": [1, 3]},
     "oracle": {"model": "sale.report", "domain": [["state", "=", "sale"], ["date", ">=", "$year_start"]], "measure": "price_subtotal:sum", "compare": {"widget": 0, "how": "sum_rows"}}},
    {"id": "S13", "user": "boshliq", "role": "manager", "category": "sales", "requires": ["sale"],
     "question": "Quantity sold per product this week",
     "expect": {"source": ["sale.report"], "measures_any": ["product_uom_qty"], "must_filter": [["state", "=", "sale"]], "widgets": [1, 3]},
     "oracle": {"model": "sale.report", "domain": [["state", "=", "sale"], ["date", ">=", "$week_start"]], "measure": "product_uom_qty:sum", "compare": {"widget": 0, "how": "sum_rows"}}},
    {"id": "S14", "user": "boshliq", "role": "manager", "category": "sales", "requires": ["sale"],
     "question": "Which customers bought from us this week?",
     "expect": {"source": ["sale.report"], "must_filter": [["state", "=", "sale"]], "widgets": [1, 3]},
     "oracle": {"model": "sale.report", "domain": [["state", "=", "sale"], ["date", ">=", "$week_start"]], "groupby": "partner_id", "measure": "price_subtotal:sum", "order": "desc", "top": 10, "compare": {"widget": 0, "how": "top_names"}}},
    {"id": "S15", "user": "boshliq", "role": "manager", "category": "limits", "requires": ["sale"],
     "question": "Compare this month's sales with last month's",
     "note": "Needs 'compare' (phase F6). Passing now means two honest widgets (this month, last month) or an honest 'not yet'.",
     "expect": {"source": ["sale.report"], "must_filter": [["state", "=", "sale"]], "widgets": [1, 4]},
     "oracle": {"model": "sale.report", "domain": [["state", "=", "sale"], ["date", ">=", "$month_start"]], "measure": "price_subtotal:sum", "compare": {"widget": 0, "how": "any_value"}}},

