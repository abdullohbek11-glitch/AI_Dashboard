     "expect": {"source": ["sale.report"], "measures_any": ["price_subtotal", "price_total"], "must_filter": [["state", "=", "sale"]], "widgets": [1, 3]},
     "oracle": {"model": "sale.report", "domain": [["state", "=", "sale"], ["date", ">=", "$last_month_start"], ["date", "<", "$month_start"]], "measure": "price_subtotal:sum", "compare": {"widget": 0, "how": "sum_rows"}}},
