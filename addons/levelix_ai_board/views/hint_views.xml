<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_hint_list" model="ir.ui.view">
        <field name="name">levelix.ai.hint.list</field>
        <field name="model">levelix.ai.hint</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="model"/>
                <field name="keywords"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_ai_hint_form" model="ir.ui.view">
        <field name="name">levelix.ai.hint.form</field>
        <field name="model">levelix.ai.hint</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group><field name="name"/><field name="model"/><field name="keywords"/><field name="active"/></group>
                    <field name="advice" placeholder="Short advice in English: which fields to use, which status means confirmed..."/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_ai_hint" model="ir.actions.act_window">
        <field name="name">Hints</field>
        <field name="res_model">levelix.ai.hint</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_levelix_ai_hints" name="Hints" parent="levelix_ai_core.menu_levelix_ai_root" sequence="32"
              action="action_ai_hint" groups="base.group_system"/>
</odoo>
