<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_levelix_board" model="ir.module.category">
        <field name="name">Levelix Board</field>
        <field name="sequence">60</field>
    </record>

    <record id="privilege_levelix_board" model="res.groups.privilege">
        <field name="name">Levelix Board</field>
        <field name="category_id" ref="module_category_levelix_board"/>
        <field name="placeholder">Own dashboards only</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_board_manager" model="res.groups">
        <field name="name">Board manager</field>
        <field name="privilege_id" ref="privilege_levelix_board"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can see and change every dashboard of the company, whoever owns it.</field>
    </record>
</odoo>
