<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_levelix_ai" model="ir.module.category">
        <field name="name">Levelix AI</field>
        <field name="sequence">61</field>
    </record>

    <record id="privilege_levelix_ai" model="res.groups.privilege">
        <field name="name">Levelix AI</field>
        <field name="category_id" ref="module_category_levelix_ai"/>
        <field name="placeholder">No assistant</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_ai_user" model="res.groups">
        <field name="name">Assistant user</field>
        <field name="privilege_id" ref="privilege_levelix_ai"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">May talk to the assistant. It reads only what the user may read.</field>
    </record>
</odoo>
